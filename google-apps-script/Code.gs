n}\n\n.allocation-item-left {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n}\n\n.allocation-item-name {\n  font-weight: 600;\n  font-size: 13px;\n}\n\n.allocation-item-share {\n  font-size: 11.5px;\n  color: var(--text-muted);\n}\n\n.allocation-item-right {\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n}\n\n.allocation-item-uah {\n  font-weight: 600;\n  font-size: 13px;\n}\n\n.allocation-item-usd {\n  font-size: 11.5px;\n  color: var(--text-secondary);\n}\n\n/* Currency exposure bars */\n.currency-bars {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.currency-row {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.currency-row-top {\n  display: flex;\n  justify-content: space-between;\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.currency-progress-bg {\n  height: 8px;\n  background-color: var(--bg-elevated);\n  border-radius: 99px;\n  overflow: hidden;\n}\n\n.currency-progress-fill {\n  height: 100%;\n  border-radius: 99px;\n  background-color: var(--accent-primary);\n}\n\n/* Positions Table & Category Cards */\n.table-container {\n  overflow-x: auto;\n  margin: 0 -22px;\n  padding: 0 22px;\n}\n\n.positions-table {\n  width: 100%;\n  border-collapse: collapse;\n  text-align: left;\n  font-size: 13.5px;\n}\n\n.positions-table th {\n  font-size: 11.5px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: var(--text-muted);\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--border-default);\n  white-space: nowrap;\n}\n\n.positions-table td {\n  padding: 13px 12px;\n  border-bottom: 1px solid var(--border-subtle);\n  vertical-align: middle;\n}\n\n.positions-table tr:last-child td {\n  border-bottom: none;\n}\n\n.positions-table tbody tr:hover {\n  background-color: hsla(220, 15%, 50%, 0.04);\n}\n\n.text-right {\n  text-align: right;\n}\n\n.asset-cell {\n  display: flex;\n  align-items: center;\n  gap: 11px;\n}\n\n.ticker-badge {\n  min-width: 44px;\n  height: 34px;\n  padding: 0 8px;\n  border-radius: 8px;\n  background-color: var(--bg-elevated);\n  border: 1px solid var(--border-default);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-mono);\n  font-weight: 700;\n  font-size: 12px;\n  color: var(--text-primary);\n}\n\n.asset-name-primary {\n  font-weight: 600;\n  color: var(--text-primary);\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.asset-name-sub {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.dual-val-primary {\n  font-weight: 600;\n  font-variant-numeric: tabular-nums;\n}\n\n.dual-val-sub {\n  font-size: 12px;\n  color: var(--text-secondary);\n  font-variant-numeric: tabular-nums;\n}\n\n.maturity-progress {\n  width: 110px;\n  height: 6px;\n  background: var(--bg-elevated);\n  border-radius: 99px;\n  overflow: hidden;\n  margin-top: 4px;\n}\n\n.maturity-progress-bar {\n  height: 100%;\n  background: var(--accent-primary);\n  border-radius: 99px;\n}\n\n.row-actions {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n\n/* Modal Styles */\n.modal-backdrop {\n  position: fixed;\n  inset: 0;\n  background-color: rgba(6, 9, 15, 0.72);\n  backdrop-filter: blur(4px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n  z-index: 100;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 150ms ease;\n}\n\n.modal-backdrop.open {\n  opacity: 1;\n  pointer-events: auto;\n}\n\n.modal-dialog {\n  background-color: var(--bg-surface);\n  border: 1px solid var(--border-default);\n  border-radius: var(--radius-lg);\n  width: 100%;\n  max-width: 540px;\n  max-height: 90vh;\n  overflow-y: auto;\n  box-shadow: var(--shadow-modal);\n  padding: 24px;\n}\n\n.modal-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 18px;\n}\n\n.modal-title {\n  font-size: 17px;\n  font-weight: 700;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 14px;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.form-group.full-width {\n  grid-column: 1 / -1;\n}\n\n.form-label {\n  font-size: 12.5px;\n  font-weight: 600;\n  color: var(--text-secondary);\n}\n\n.form-input, .form-select {\n  width: 100%;\n  padding: 9px 12px;\n  background-color: var(--bg-elevated);\n  border: 1px solid var(--border-default);\n  border-radius: var(--radius-sm);\n  color: var(--text-primary);\n  font-family: inherit;\n  font-size: 13.5px;\n  transition: border-color var(--transition-fast);\n}\n\n.form-input:focus, .form-select:focus {\n  outline: none;\n  border-color: var(--accent-primary);\n}\n\n.quick-tickers {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-top: 4px;\n}\n\n.chip-btn {\n  padding: 3px 9px;\n  font-size: 11.5px;\n  font-family: var(--font-mono);\n  border-radius: 6px;\n  border: 1px solid var(--border-default);\n  background: var(--bg-elevated);\n  color: var(--text-secondary);\n  cursor: pointer;\n}\n\n.chip-btn:hover {\n  border-color: var(--accent-primary);\n  color: var(--text-primary);\n}\n\n.modal-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 10px;\n  margin-top: 22px;\n  padding-top: 16px;\n  border-top: 1px solid var(--border-subtle);\n}\n\n/* Mobile Bottom Nav */\n.mobile-nav {\n  display: none;\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background-color: var(--bg-surface);\n  border-top: 1px solid var(--border-default);\n  padding: 6px 8px;\n  z-index: 40;\n  justify-content: space-around;\n}\n\n.mobile-nav-btn {\n  background: none;\n  border: none;\n  color: var(--text-muted);\n  font-family: inherit;\n  font-size: 11px;\n  font-weight: 600;\n  padding: 6px 8px;\n  border-radius: 8px;\n  cursor: pointer;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 3px;\n}\n\n.mobile-nav-btn.active {\n  color: var(--accent-primary);\n  background-color: var(--accent-primary-soft);\n}\n\n/* Responsive Breakpoints */\n@media (max-width: 1024px) {\n  .wealth-hero {\n    grid-template-columns: 1fr;\n    gap: 16px;\n  }\n  .wealth-primary-block {\n    border-right: none;\n    border-bottom: 1px solid var(--border-subtle);\n    padding-right: 0;\n    padding-bottom: 14px;\n  }\n  .overview-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 780px) {\n  .app-shell {\n    grid-template-columns: 1fr;\n  }\n  .sidebar {\n    display: none;\n  }\n  .mobile-nav {\n    display: flex;\n  }\n  .topbar {\n    padding: 12px 16px;\n  }\n  .page-content {\n    padding: 16px;\n  }\n  .form-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n</style>\n</head>\n<body>\n  <div class=\"app-shell\" id=\"app-shell\">\n    <!-- Sidebar Navigation -->\n    <aside class=\"sidebar\" aria-label=\"Категорії портфеля\">\n      <div class=\"brand-header\">\n        <a href=\"javascript:void(0)\" class=\"brand-logo\" id=\"brand-home-link\">\n          <div class=\"brand-mark\">К</div>\n          <div>\n            <div class=\"brand-title\">КАПІТАЛ</div>\n            <span class=\"brand-subtitle\">Трекер інвестицій</span>\n          </div>\n        </a>\n        <button type=\"button\" class=\"btn btn-ghost\" id=\"btn-theme-toggle\" title=\"Змінити тему (Темна / Світла)\" aria-label=\"Перемкнути тему\">\n          ◐\n        </button>\n      </div>\n\n      <div class=\"nav-section-label\">Огляд та активи</div>\n      <ul class=\"nav-list\" id=\"sidebar-nav-list\">\n        <li>\n          <button type=\"button\" class=\"nav-btn active\" data-category=\"all\" id=\"nav-cat-all\">\n            <span class=\"nav-btn-left\">\n              <span class=\"cat-dot\" style=\"background: var(--accent-primary)\"></span>\n              <span>Загальна картина</span>\n            </span>\n            <span class=\"nav-badge\" id=\"badge-count-all\">0</span>\n          </button>\n        </li>\n        <li>\n          <button type=\"button\" class=\"nav-btn\" data-category=\"crypto\" id=\"nav-cat-crypto\">\n            <span class=\"nav-btn-left\">\n              <span class=\"cat-dot\" style=\"background: var(--cat-crypto)\"></span>\n              <span>Криптовалюта</span>\n            </span>\n            <span class=\"nav-badge\" id=\"badge-count-crypto\">0</span>\n          </button>\n        </li>\n        <li>\n          <button type=\"button\" class=\"nav-btn\" data-category=\"stocks\" id=\"nav-cat-stocks\">\n            <span class=\"nav-btn-left\">\n              <span class=\"cat-dot\" style=\"background: var(--cat-stocks)\"></span>\n              <span>Фондовий ринок</span>\n            </span>\n            <span class=\"nav-badge\" id=\"badge-count-stocks\">0</span>\n          </button>\n        </li>\n        <li>\n          <button type=\"button\" class=\"nav-btn\" data-category=\"ovdp\" id=\"nav-cat-ovdp\">\n            <span class=\"nav-btn-left\">\n              <span class=\"cat-dot\" style=\"background: var(--cat-ovdp)\"></span>\n              <span>ОВДП (Облігації)</span>\n            </span>\n            <span class=\"nav-badge\" id=\"badge-count-ovdp\">0</span>\n          </button>\n        </li>\n        <li>\n          <button type=\"button\" class=\"nav-btn\" data-category=\"deposits\" id=\"nav-cat-deposits\">\n            <span class=\"nav-btn-left\">\n              <span class=\"cat-dot\" style=\"background: var(--cat-deposits)\"></span>\n              <span>Депозити</span>\n            </span>\n            <span class=\"nav-badge\" id=\"badge-count-deposits\">0</span>\n          </button>\n        </li>\n        <li>\n          <button type=\"button\" class=\"nav-btn\" data-category=\"cash\" id=\"nav-cat-cash\">\n            <span class=\"nav-btn-left\">\n              <span class=\"cat-dot\" style=\"background: var(--cat-cash)\"></span>\n              <span>Готівка та рахунки</span>\n            </span>\n            <span class=\"nav-badge\" id=\"badge-count-cash\">0</span>\n          </button>\n        </li>\n      </ul>\n\n      <div class=\"sidebar-footer\">\n        <div class=\"fx-Rate-box\" id=\"sidebar-fx-box\">\n          <div class=\"fx-rate-header\">\n            <span>Курс валют</span>\n            <button type=\"button\" class=\"btn-ghost\" id=\"btn-edit-fx\" style=\"font-size:11px; padding:1px 5px; border-radius:4px;\">Змінити</button>\n          </div>\n          <div class=\"fx-rate-row tabular\">\n            <span>🇺🇸 USD / UAH</span>\n            <span id=\"fx-usd-uah\">41.65 ₴</span>\n          </div>\n          <div class=\"fx-rate-row tabular\">\n            <span>🇪🇺 EUR / UAH</span>\n            <span id=\"fx-eur-uah\">44.80 ₴</span>\n          </div>\n        </div>\n\n        <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-open-settings\" style=\"width:100%;\">\n          ⚙ Налаштування та Пароль\n        </button>\n      </div>\n    </aside>\n\n    <!-- Main Workspace -->\n    <main class=\"main-area\">\n      <!-- Sticky Topbar -->\n      <header class=\"topbar\">\n        <div class=\"topbar-title-group\">\n          <h1 id=\"page-main-heading\">Загальна картина портфеля</h1>\n          <div class=\"topbar-subtitle\">\n            <span class=\"live-pulse\" id=\"quote-status-dot\"></span>\n            <span id=\"quote-status-text\">Котирування активів оновлено автоматично</span>\n          </div>\n        </div>\n\n        <div class=\"topbar-controls\">\n          <div class=\"segmented-control\" role=\"group\" aria-label=\"Пріоритетна валюта відображення\">\n            <button type=\"button\" class=\"seg-btn active\" data-currency=\"UAH\" id=\"btn-curr-uah\">₴ UAH + $ USD</button>\n            <button type=\"button\" class=\"seg-btn\" data-currency=\"USD\" id=\"btn-curr-usd\">$ USD + ₴ UAH</button>\n          </div>\n\n          <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-refresh-quotes\" title=\"Оновити ринкові ціни крипти, акцій та курсу валют\">\n            ↻ Оновити ціни\n          </button>\n\n          <button type=\"button\" class=\"btn btn-primary\" id=\"btn-add-position\">\n            + Додати актив\n          </button>\n        </div>\n      </header>\n\n      <div class=\"page-content\">\n        <!-- Hero Dual-Currency Summary Strip -->\n        <section class=\"wealth-hero\" aria-label=\"Підсумок капіталу\">\n          <div class=\"wealth-primary-block\">\n            <div class=\"metric-eyebrow\">\n              <span id=\"hero-scope-label\">Сукупний капітал (Усі активи)</span>\n            </div>\n            <div class=\"wealth-dual-values\">\n              <div class=\"wealth-main-amount\" id=\"hero-primary-total\">0 ₴</div>\n              <div class=\"wealth-secondary-amount\" id=\"hero-secondary-total\">$0.00</div>\n            </div>\n            <div class=\"wealth-stat-sub\" id=\"hero-fx-caption\">\n              Перераховано за курсом 1$ = 41.65 ₴ · 1€ = 44.80 ₴\n            </div>\n          </div>\n\n          <div class=\"wealth-stat-block\">\n            <div class=\"metric-eyebrow\">Сукупний прибуток (PnL + Нараховані %)</div>\n            <div class=\"wealth-stat-value\" id=\"hero-pnl-primary\">+0 ₴</div>\n            <div class=\"wealth-stat-sub\">\n              <span id=\"hero-pnl-secondary\">+$0.00</span>\n              <span class=\"pill-badge pill-positive\" id=\"hero-pnl-pct\">+0.00%</span>\n            </div>\n          </div>\n\n          <div class=\"wealth-stat-block\">\n            <div class=\"metric-eyebrow\">Пасивний дохід (ОВДП + Депозити)</div>\n            <div class=\"wealth-stat-value\" id=\"hero-yield-accrued\">+0 ₴</div>\n            <div class=\"wealth-stat-sub\">\n              <span id=\"hero-yield-sub\">Накопичено на сьогодні · Прогноз за рік: <strong id=\"hero-annual-passive\">0 ₴</strong></span>\n            </div>\n          </div>\n        </section>\n\n        <!-- Overview Breakdown Section (Shown on 'all' view) -->\n        <section class=\"overview-grid\" id=\"overview-breakdown-section\" aria-label=\"Структура портфеля\">\n          <div class=\"panel-card\">\n            <div class=\"panel-header\">\n              <div>\n                <div class=\"panel-title\">Розподіл за категоріями активів</div>\n                <div class=\"panel-subtitle\">Натисніть на категорію для детального перегляду та керування</div>\n              </div>\n            </div>\n            <div class=\"allocation-bar-track\" id=\"allocation-stacked-bar\"></div>\n            <div class=\"allocation-list\" id=\"allocation-cards-grid\"></div>\n          </div>\n\n          <div class=\"panel-card\">\n            <div class=\"panel-header\">\n              <div>\n                <div class=\"panel-title\">Валютна структура капіталу</div>\n                <div class=\"panel-subtitle\">Фактична валюта активів (крипта та акції США = USD)</div>\n              </div>\n            </div>\n            <div class=\"currency-bars\" id=\"currency-exposure-list\"></div>\n          </div>\n        </section>\n\n        <!-- Positions Table Panel -->\n        <section class=\"panel-card\" aria-label=\"Список активів\">\n          <div class=\"panel-header\">\n            <div>\n              <div class=\"panel-title\" id=\"table-section-title\">Усі активи портфеля</div>\n              <div class=\"panel-subtitle\" id=\"table-section-subtitle\">Автоматичний розрахунок поточної вартості в ₴ UAH та $ USD</div>\n            </div>\n            <div style=\"display:flex; gap:8px; align-items:center;\">\n              <input\n                type=\"search\"\n                id=\"input-search-positions\"\n                class=\"form-input\"\n                placeholder=\"Пошук за назвою або тікером...\"\n                style=\"width:230px; padding:6px 11px; font-size:12.5px;\"\n              />\n            </div>\n          </div>\n\n          <div class=\"table-container\">\n            <table class=\"positions-table\" id=\"positions-table\">\n              <thead id=\"positions-table-head\"></thead>\n              <tbody id=\"positions-table-body\"></tbody>\n            </table>\n          </div>\n        </section>\n      </div>\n    </main>\n\n    <!-- Mobile Bottom Bar -->\n    <nav class=\"mobile-nav\" aria-label=\"Мобільна навігація\">\n      <button type=\"button\" class=\"mobile-nav-btn active\" data-category=\"all\" id=\"mob-cat-all\">Всі</button>\n      <button type=\"button\" class=\"mobile-nav-btn\" data-category=\"crypto\" id=\"mob-cat-crypto\">Крипта</button>\n      <button type=\"button\" class=\"mobile-nav-btn\" data-category=\"stocks\" id=\"mob-cat-stocks\">Акції</button>\n      <button type=\"button\" class=\"mobile-nav-btn\" data-category=\"ovdp\" id=\"mob-cat-ovdp\">ОВДП</button>\n      <button type=\"button\" class=\"mobile-nav-btn\" data-category=\"deposits\" id=\"mob-cat-deposits\">Депозит</button>\n      <button type=\"button\" class=\"mobile-nav-btn\" data-category=\"cash\" id=\"mob-cat-cash\">Готівка</button>\n    </nav>\n  </div>\n\n  <!-- Add / Edit Position Modal -->\n  <div class=\"modal-backdrop\" id=\"modal-position\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-position-title\">\n    <div class=\"modal-dialog\">\n      <div class=\"modal-header\">\n        <h2 class=\"modal-title\" id=\"modal-position-title\">Додати інвестиційний актив</h2>\n        <button type=\"button\" class=\"btn btn-ghost\" id=\"btn-close-position-modal\">✕</button>\n      </div>\n\n      <form id=\"form-position\">\n        <input type=\"hidden\" id=\"pos-id\" value=\"\" />\n        <div class=\"form-grid\">\n          <div class=\"form-group full-width\">\n            <label class=\"form-label\" for=\"pos-category\">Категорія інвестиції</label>\n            <select class=\"form-select\" id=\"pos-category\" required>\n              <option value=\"crypto\">Криптовалюта (Автопідтягування ціни)</option>\n              <option value=\"stocks\">Фондовий ринок — Акції та ETF (Автопідтягування ціни)</option>\n              <option value=\"ovdp\">ОВДП — Військові та держоблігації (Авторозрахунок % доходу)</option>\n              <option value=\"deposits\">Банківський депозит (Авторозрахунок % доходу)</option>\n              <option value=\"cash\">Готівка / Картковий рахунок</option>\n            </select>\n          </div>\n\n          <div id=\"dynamic-form-fields\" class=\"form-grid full-width\" style=\"grid-column: 1 / -1;\"></div>\n        </div>\n\n        <div class=\"modal-footer\">\n          <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-cancel-position\">Скасувати</button>\n          <button type=\"submit\" class=\"btn btn-primary\" id=\"btn-save-position\">Зберегти актив</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- Settings, FX & Password Auth Modal -->\n  <div class=\"modal-backdrop\" id=\"modal-settings\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-settings-title\">\n    <div class=\"modal-dialog\">\n      <div class=\"modal-header\">\n        <h2 class=\"modal-title\" id=\"modal-settings-title\">Налаштування, Курси валют та Безпека</h2>\n        <button type=\"button\" class=\"btn btn-ghost\" id=\"btn-close-settings-modal\">✕</button>\n      </div>\n\n      <form id=\"form-settings\">\n        <div class=\"form-grid\">\n          <div class=\"form-group full-width\">\n            <label class=\"form-label\">\n              <input type=\"checkbox\" id=\"set-manual-fx\" />\n              Використовувати власний фіксований курс валют (замість автокурсу НБУ)\n            </label>\n          </div>\n\n          <div class=\"form-group\">\n            <label class=\"form-label\" for=\"set-usd-uah\">Курс USD → UAH (₴ за 1$)</label>\n            <input type=\"number\" step=\"0.01\" min=\"1\" class=\"form-input tabular\" id=\"set-usd-uah\" required />\n          </div>\n\n          <div class=\"form-group\">\n            <label class=\"form-label\" for=\"set-eur-uah\">Курс EUR → UAH (₴ за 1€)</label>\n            <input type=\"number\" step=\"0.01\" min=\"1\" class=\"form-input tabular\" id=\"set-eur-uah\" required />\n          </div>\n\n          <div class=\"form-group full-width\" style=\"margin-top:8px; padding-top:12px; border-top:1px solid var(--border-subtle);\">\n            <label class=\"form-label\">\n              <input type=\"checkbox\" id=\"set-require-auth\" />\n              Запитувати пароль при відкритті сайту в інтернеті\n            </label>\n          </div>\n\n          <div class=\"form-group full-width\">\n            <label class=\"form-label\" for=\"set-new-password\">Новий пароль власника (за замовчуванням: admin123)</label>\n            <input type=\"password\" class=\"form-input\" id=\"set-new-password\" placeholder=\"Залиште порожнім, щоб не змінювати\" />\n          </div>\n\n          <div class=\"form-group full-width\" style=\"margin-top:8px; padding-top:12px; border-top:1px solid var(--border-subtle);\">\n            <div class=\"form-label\">Резервне копіювання та дані портфеля</div>\n            <div style=\"display:flex; gap:10px; flex-wrap:wrap; margin-top:4px;\">\n              <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-export-json\">⬇ Експорт JSON</button>\n              <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-import-json\">⬆ Імпорт JSON</button>\n              <input type=\"file\" id=\"input-import-json-file\" accept=\".json,application/json\" style=\"display:none;\" />\n              <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-reset-demo\">Відновити приклади активів</button>\n              <button type=\"button\" class=\"btn btn-danger\" id=\"btn-clear-all-data\">Очистити всі позиції</button>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"modal-footer\">\n          <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-cancel-settings\">Закрити</button>\n          <button type=\"submit\" class=\"btn btn-primary\" id=\"btn-save-settings\">Зберегти налаштування</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- Login Lock Screen Modal (When requireAuth is enabled) -->\n  <div class=\"modal-backdrop\" id=\"modal-login\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-login-title\">\n    <div class=\"modal-dialog\" style=\"max-width: 400px;\">\n      <div class=\"modal-header\">\n        <h2 class=\"modal-title\" id=\"modal-login-title\">🔒 Вхід до персонального портфеля</h2>\n      </div>\n      <form id=\"form-login\">\n        <div class=\"form-group\">\n          <label class=\"form-label\" for=\"login-password\">Введіть пароль власника</label>\n          <input type=\"password\" class=\"form-input\" id=\"login-password\" placeholder=\"Пароль (напр. admin123)\" required />\n          <div id=\"login-error-msg\" style=\"color: var(--negative); font-size: 12px; display:none;\">Невірний пароль</div>\n        </div>\n        <div class=\"modal-footer\">\n          <button type=\"submit\" class=\"btn btn-primary\" style=\"width:100%;\">Увійти</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <script>\n/* КАПІТАЛ — Персональний трекер інвестиційного портфеля */\n(function () {\n  'use strict';\n\n  const CATEGORY_META = {\n    all: {\n      title: 'Загальна картина портфеля',\n      subtitle: 'Усі активи з автоматичним перерахунком у Гривню (₴) та Долар США ($)',\n      color: 'var(--accent-primary)',\n      shortName: 'Усі активи'\n    },\n    crypto: {\n      title: 'Криптовалютні активи',\n      subtitle: 'Автоматичне підтягування котирувань (Binance / CoinGecko) та розрахунок PnL',\n      color: 'var(--cat-crypto)',\n      shortName: 'Криптовалюта'\n    },\n    stocks: {\n      title: 'Фондовий ринок (Акції та ETF)',\n      subtitle: 'Автоматичне підтягування ринкових цін акцій США та світових ETF',\n      color: 'var(--cat-stocks)',\n      shortName: 'Фондовий ринок'\n    },\n    ovdp: {\n      title: 'ОВДП (Державні та військові облігації)',\n      subtitle: 'Автоматичний розрахунок накопиченого доходу за річною ставкою (0% податків)',\n      color: 'var(--cat-ovdp)',\n      shortName: 'ОВДП'\n    },\n    deposits: {\n      title: 'Банківські депозити',\n      subtitle: 'Автоматичний підрахунок нарахованих відсотків з урахуванням податку або чистої ставки',\n      color: 'var(--cat-deposits)',\n      shortName: 'Депозити'\n    },\n    cash: {\n      title: 'Готівка та поточні рахунки',\n      subtitle: 'Облік готівкових заощаджень, сейфу та банківських карток у різних валютах',\n      color: 'var(--cat-cash)',\n      shortName: 'Готівка'\n    }\n  };\n\n  const QUICK_CRYPTO = ['BTC', 'ETH', 'SOL', 'USDT', 'TON', 'BNB', 'XRP', 'ADA', 'SUI', 'DOGE', 'LINK', 'AVAX'];\n  const QUICK_STOCKS = ['VOO', 'SPY', 'VWCE', 'CSP1', 'QQQ', 'NVDA', 'AAPL', 'MSFT', 'GOOGL', 'AMZN', 'META', 'TSLA', 'GLD'];\n\n  function safeGetItem(key) {\n    try {\n      return window.localStorage ? window.localStorage.getItem(key) : null;\n    } catch (_) {\n      return null;\n    }\n  }\n\n  function safeSetItem(key, val) {\n    try {\n      if (window.localStorage) window.localStorage.setItem(key, val);\n    } catch (_) {}\n  }\n\n  const state = {\n    activeCategory: 'all',\n    primaryCurrency: 'UAH',\n    searchQuery: '',\n    token: safeGetItem('kapital_auth_token') || '',\n    settings: {\n      primaryCurrency: 'UAH',\n      manualFxOverride: false,\n      fxRates: {\n        USD_UAH: 41.65,\n        EUR_UAH: 44.80\n      },\n      depositTaxDefault: true,\n      depositTaxRate: 23.0\n    },\n    auth: {\n      requireAuth: false\n    },\n    quotes: {\n      fx: {\n        USD_UAH: 41.65,\n        EUR_UAH: 44.80,\n        GBP_UAH: 52.80,\n        PLN_UAH: 10.35,\n        updatedAt: new Date().toISOString(),\n        source: 'Автокотирування'\n      },\n      crypto: {},\n      stocks: {}\n    },\n    positions: []\n  };\n\n  // Formatters\n  function fmtUah(val, showSign = false) {\n    const num = Number(val) || 0;\n    const sign = showSign && num > 0 ? '+' : '';\n    return sign + new Intl.NumberFormat('uk-UA', {\n      minimumFractionDigits: Math.abs(num) < 100 ? 2 : 0,\n      maximumFractionDigits: Math.abs(num) < 100 ? 2 : 0\n    }).format(num) + ' ₴';\n  }\n\n  function fmtUsd(val, showSign = false) {\n    const num = Number(val) || 0;\n    const sign = showSign && num > 0 ? '+' : (num < 0 ? '-' : '');\n    const abs = Math.abs(num);\n    const decimals = abs > 0 && abs < 1 ? 4 : 2;\n    return sign + '$' + new Intl.NumberFormat('en-US', {\n      minimumFractionDigits: decimals,\n      maximumFractionDigits: decimals\n    }).format(abs);\n  }\n\n  function fmtCurr(val, currency = 'UAH') {\n    const num = Number(val) || 0;\n    if (currency === 'UAH') return fmtUah(num);\n    if (currency === 'USD') return fmtUsd(num);\n    const symbols = { EUR: '€', GBP: '£', PLN: 'zł' };\n    const sym = symbols[currency] || currency + ' ';\n    return sym + new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(num);\n  }\n\n  function fmtPct(val, showSign = true) {\n    const num = Number(val) || 0;\n    const sign = showSign && num > 0 ? '+' : '';\n    return sign + num.toFixed(2) + '%';\n  }\n\n  // Exchange rate conversions\n  function getEffectiveRates() {\n    const usdUah = state.settings.manualFxOverride\n      ? (Number(state.settings.fxRates?.USD_UAH) || 41.65)\n      : (Number(state.quotes.fx?.USD_UAH) || 41.65);\n    const eurUah = state.settings.manualFxOverride\n      ? (Number(state.settings.fxRates?.EUR_UAH) || 44.80)\n      : (Number(state.quotes.fx?.EUR_UAH) || 44.80);\n    const gbpUah = Number(state.quotes.fx?.GBP_UAH) || (usdUah * 1.27);\n    const plnUah = Number(state.quotes.fx?.PLN_UAH) || (usdUah * 0.25);\n\n    return { USD_UAH: usdUah, EUR_UAH: eurUah, GBP_UAH: gbpUah, PLN_UAH: plnUah };\n  }\n\n  function toUah(amount, currency) {\n    const rates = getEffectiveRates();\n    const val = Number(amount) || 0;\n    switch ((currency || 'UAH').toUpperCase()) {\n      case 'UAH': return val;\n      case 'USD': return val * rates.USD_UAH;\n      case 'EUR': return val * rates.EUR_UAH;\n      case 'GBP': return val * rates.GBP_UAH;\n      case 'PLN': return val * rates.PLN_UAH;\n      default: return val;\n    }\n  }\n\n  function toUsd(amount, currency) {\n    const rates = getEffectiveRates();\n    const uah = toUah(amount, currency);\n    return rates.USD_UAH > 0 ? uah / rates.USD_UAH : 0;\n  }\n\n  // Date helpers for OVDP and Deposits yield calculation\n  function computeFixedIncomeStats(startDateStr, endDateStr, principal, annualRatePct, taxPct = 0) {\n    const now = new Date();\n    const start = startDateStr ? new Date(startDateStr) : new Date(now.getFullYear(), 0, 1);\n    const end = endDateStr ? new Date(endDateStr) : new Date(now.getFullYear() + 1, 0, 1);\n\n    const msPerDay = 1000 * 60 * 60 * 24;\n    const totalDays = Math.max(1, Math.round((end - start) / msPerDay));\n    const elapsedDaysRaw = Math.round((now - start) / msPerDay);\n    const elapsedDays = Math.max(0, Math.min(totalDays, elapsedDaysRaw));\n    const progressPct = Math.min(100, Math.max(0, (elapsedDays / totalDays) * 100));\n\n    const netRatePct = annualRatePct * (1 - (Number(taxPct) || 0) / 100);\n    const accruedInterest = principal * (netRatePct / 100) * (elapsedDays / 365);\n    const fullTermInterest = principal * (netRatePct / 100) * (totalDays / 365);\n    const annualPassive = principal * (netRatePct / 100);\n\n    return {\n      totalDays,\n      elapsedDays,\n      progressPct,\n      netRatePct,\n      accruedInterest,\n      fullTermInterest,\n      annualPassive,\n      currentTotal: principal + accruedInterest\n    };\n  }\n\n  // Enrich a position with live market values in both UAH and USD\n  function evaluatePosition(pos) {\n    const rates = getEffectiveRates();\n    const cat = pos.category;\n\n    if (cat === 'crypto' || cat === 'stocks') {\n      const ticker = (pos.ticker || '').toUpperCase().trim();\n      const quoteBook = cat === 'crypto' ? state.quotes.crypto : state.quotes.stocks;\n      const quote = quoteBook?.[ticker];\n      const livePriceUsd = quote?.priceUsd !== undefined\n        ? Number(quote.priceUsd)\n        : (Number(pos.customCurrentPriceUsd) || Number(pos.buyPriceUsd) || 0);\n      const change24h = quote?.change24h !== undefined ? Number(quote.change24h) : 0;\n\n      const qty = Number(pos.quantity) || 0;\n      const buyPriceUsd = Number(pos.buyPriceUsd) || 0;\n      const investedUsd = qty * buyPriceUsd;\n      const currentValUsd = qty * livePriceUsd;\n      const currentValUah = currentValUsd * rates.USD_UAH;\n      const investedUah = investedUsd * rates.USD_UAH;\n      const pnlUsd = currentValUsd - investedUsd;\n      const pnlUah = currentValUah - investedUah;\n      const pnlPct = investedUsd > 0 ? (pnlUsd / investedUsd) * 100 : 0;\n\n      return {\n        ...pos,\n        ticker,\n        displayName: pos.name || quote?.name || ticker,\n        nativeCurrency: 'USD',\n        livePriceUsd,\n        change24h,\n        investedUsd,\n        investedUah,\n        currentValUsd,\n        currentValUah,\n        pnlUsd,\n        pnlUah,\n        pnlPct,\n        accruedUah: 0,\n        annualPassiveUah: 0\n      };\n    }\n\n    if (cat === 'ovdp') {\n      const curr = (pos.currency || 'UAH').toUpperCase();\n      const principal = Number(pos.principalAmount) || ((Number(pos.bondsCount) || 1) * (Number(pos.faceValue) || 1000));\n      const rate = Number(pos.annualRate) || 16.0;\n      const stats = computeFixedIncomeStats(pos.startDate, pos.maturityDate, principal, rate, 0);\n\n      const investedUah = toUah(principal, curr);\n      const investedUsd = toUsd(principal, curr);\n      const currentValUah = toUah(stats.currentTotal, curr);\n      const currentValUsd = toUsd(stats.currentTotal, curr);\n      const pnlUah = toUah(stats.accruedInterest, curr);\n      const pnlUsd = toUsd(stats.accruedInterest, curr);\n      const pnlPct = principal > 0 ? (stats.accruedInterest / principal) * 100 : 0;\n\n      return {\n        ...pos,\n        displayName: pos.name || 'ОВДП України',\n        nativeCurrency: curr,\n        principalNative: principal,\n        accruedNative: stats.accruedInterest,\n        fullTermNative: stats.fullTermInterest,\n        netRatePct: stats.netRatePct,\n        elapsedDays: stats.elapsedDays,\n        totalDays: stats.totalDays,\n        progressPct: stats.progressPct,\n        investedUah,\n        investedUsd,\n        currentValUah,\n        currentValUsd,\n        pnlUah,\n        pnlUsd,\n        pnlPct,\n        accruedUah: pnlUah,\n        annualPassiveUah: toUah(stats.annualPassive, curr)\n      };\n    }\n\n    if (cat === 'deposits') {\n      const curr = (pos.currency || 'UAH').toUpperCase();\n      const principal = Number(pos.principalAmount) || 0;\n      const rate = Number(pos.annualRate) || 14.0;\n      const taxPct = pos.applyTax ? (Number(pos.taxRate) || 23.0) : 0;\n      const stats = computeFixedIncomeStats(pos.startDate, pos.endDate, principal, rate, taxPct);\n\n      const investedUah = toUah(principal, curr);\n      const investedUsd = toUsd(principal, curr);\n      const currentValUah = toUah(stats.currentTotal, curr);\n      const currentValUsd = toUsd(stats.currentTotal, curr);\n      const pnlUah = toUah(stats.accruedInterest, curr);\n      const pnlUsd = toUsd(stats.accruedInterest, curr);\n      const pnlPct = principal > 0 ? (stats.accruedInterest / principal) * 100 : 0;\n\n      return {\n        ...pos,\n        displayName: pos.name || `Депозит (${pos.bank || 'Банк'})`,\n        nativeCurrency: curr,\n        principalNative: principal,\n        accruedNative: stats.accruedInterest,\n        fullTermNative: stats.fullTermInterest,\n        netRatePct: stats.netRatePct,\n        elapsedDays: stats.elapsedDays,\n        totalDays: stats.totalDays,\n        progressPct: stats.progressPct,\n        investedUah,\n        investedUsd,\n        currentValUah,\n        currentValUsd,\n        pnlUah,\n        pnlUsd,\n        pnlPct,\n        accruedUah: pnlUah,\n        annualPassiveUah: toUah(stats.annualPassive, curr)\n      };\n    }\n\n    // Cash\n    const curr = (pos.currency || 'USD').toUpperCase();\n    const amount = Number(pos.amount) || 0;\n    const currentValUah = toUah(amount, curr);\n    const currentValUsd = toUsd(amount, curr);\n\n    return {\n      ...pos,\n      displayName: pos.name || `Готівка (${curr})`,\n      nativeCurrency: curr,\n      amountNative: amount,\n      investedUah: currentValUah,\n      investedUsd: currentValUsd,\n      currentValUah,\n      currentValUsd,\n      pnlUah: 0,\n      pnlUsd: 0,\n      pnlPct: 0,\n      accruedUah: 0,\n      annualPassiveUah: 0\n    };\n  }\n\n  // Baseline quotes & demo positions for standalone / Google Drive fallback\n  const DEFAULT_QUOTES = {\n    fx: { USD_UAH: 41.65, EUR_UAH: 44.80, GBP_UAH: 52.80, PLN_UAH: 10.35, updatedAt: new Date().toISOString(), source: 'НБУ / Ринковий курс' },\n    crypto: {\n      BTC: { priceUsd: 91450.00, change24h: 2.84, name: 'Bitcoin' },\n      ETH: { priceUsd: 3120.50, change24h: 1.45, name: 'Ethereum' },\n      SOL: { priceUsd: 214.80, change24h: 4.92, name: 'Solana' },\n      USDT: { priceUsd: 1.00, change24h: 0.01, name: 'Tether USDT' },\n      USDC: { priceUsd: 1.00, change24h: 0.00, name: 'USD Coin' },\n      BNB: { priceUsd: 642.30, change24h: 0.85, name: 'BNB' },\n      XRP: { priceUsd: 1.12, change24h: 6.10, name: 'XRP' },\n      TON: { priceUsd: 5.48, change24h: 1.90, name: 'Toncoin' },\n      ADA: { priceUsd: 0.78, change24h: 3.20, name: 'Cardano' },\n      DOGE: { priceUsd: 0.37, change24h: 5.15, name: 'Dogecoin' },\n      AVAX: { priceUsd: 34.90, change24h: 2.10, name: 'Avalanche' },\n      LINK: { priceUsd: 14.95, change24h: 1.75, name: 'Chainlink' },\n      SUI: { priceUsd: 3.28, change24h: 7.40, name: 'Sui' }\n    },\n    stocks: {\n      VOO: { priceUsd: 548.60, change24h: 0.62, name: 'Vanguard S&P 500 ETF' },\n      SPY: { priceU